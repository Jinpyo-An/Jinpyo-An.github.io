---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${profile.name} — 이력서`}>
  <header class="mb-10">
    <h1 class="text-2xl font-bold text-ink">{profile.name}</h1>
    <p class="mt-1 text-ink-muted">{profile.tagline}</p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm text-ink-subtle">
      <a href={profile.githubUrl} target="_blank" rel="noreferrer" class="hover:text-accent">
        {profile.githubUrl}
      </a>
      <a href={`mailto:${profile.email}`} class="hover:text-accent">{profile.email}</a>
    </div>
  </header>

  <Section title="소개">
    {profile.intro.map((paragraph) => <p class="mb-3 text-sm leading-relaxed text-ink-muted">{paragraph}</p>)}
  </Section>

  <Section title="Projects">
    <div class="grid gap-3">
      {
        projects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}/`}
            title={project.data.title}
            period={project.data.period}
            summary={project.data.summary}
            techStack={project.data.techStack}
          />
        ))
      }
    </div>
  </Section>

  <Section title="Education">
    <ul class="space-y-3">
      {
        profile.education.map((entry) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <p class="font-medium text-ink">{entry.school}</p>
              <p class="text-sm text-ink-muted">{entry.degree}</p>
            </div>
            <p class="text-xs text-ink-subtle">{entry.period}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Certifications">
    <ul class="space-y-2">
      {
        profile.certifications.map((cert) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-sm text-ink">{cert.name}</p>
            <p class="text-xs text-ink-subtle">{cert.date}</p>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
