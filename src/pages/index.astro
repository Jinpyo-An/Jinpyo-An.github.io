---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const troubleshootingEntries = await getCollection('troubleshooting');
const printName = `${profile.name}_이력서`;

// 프로젝트 카드의 "문제 해결" 불릿에 쓸 트러블슈팅 케이스를, frontmatter의
// slug 배열(노출 순서) 그대로 troubleshooting 컬렉션에서 찾아 제목·링크로 변환한다.
function resolveTroubleshootingHighlights(projectId: string, slugs: string[] | undefined) {
  if (!slugs) return [];
  return slugs
    .map((slug) => ({
      slug,
      entry: troubleshootingEntries.find((entry) => entry.id === `${projectId}/${slug}`),
    }))
    .filter(({ entry }) => entry !== undefined)
    .map(({ slug, entry }) => ({
      title: entry!.data.title,
      href: `/projects/${projectId}/troubleshooting/${slug}/`,
    }));
}
---

<Base printName={printName}>
  <header class="mb-6 print:mb-3">
    <h1
      class="text-[26px] md:text-[34px] print:text-[22px] font-bold leading-[1.25] tracking-tight mb-5 print:mb-2"
    >
      {profile.headline}
    </h1>
    <div class="flex items-center gap-2 text-[14px]">
      <a
        href={profile.githubUrl}
        target="_blank"
        rel="noopener"
        title="GitHub"
        class="inline-flex items-center justify-center w-[26px] h-[26px] rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.58 0-.29-.01-1.04-.02-2.05-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 3-.4c1.02 0 2.05.13 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.85.12 3.15.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .33.22.7.83.58A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"
          ></path></svg
        >
      </a>
      <a href={`mailto:${profile.email}`} class="flex items-center gap-2 group">
        <span
          class="inline-flex items-center justify-center w-[26px] h-[26px] rounded border border-[var(--color-line)] group-hover:border-[#EA4335] transition-colors flex-shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 24 18"
            ><path
              fill="#EA4335"
              d="M24 .5v17c0 .276-.224.5-.5.5H20V7.225L12 12.5 4 7.225V18H.5a.5.5 0 0 1-.5-.5V.5C0 .107.37-.164.724.077L12 7.5 23.276.077C23.63-.164 24 .107 24 .5z"
            ></path></svg
          >
        </span>
        <span class="font-medium text-[var(--color-ink)] group-hover:text-[#EA4335] transition-colors">
          {profile.email}
        </span>
      </a>
    </div>
  </header>

  <div
    class="mt-10 print:mt-4 space-y-4 print:space-y-1.5 text-[15px] leading-[1.8] print:leading-[1.45] text-[var(--color-ink)]"
  >
    {profile.intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <Section title="Projects" id="projects">
    {
      projects.map((project) => (
        <ProjectEntry
          href={`/projects/${project.id}/`}
          title={project.data.title}
          role={project.data.role}
          period={project.data.period}
          summary={project.data.summary}
          techStack={project.data.techStack}
          implementationHighlights={project.data.implementationHighlights}
          troubleshootingHighlights={resolveTroubleshootingHighlights(
            project.id,
            project.data.troubleshootingHighlights
          )}
        />
      ))
    }
  </Section>

  <Section title="Education" id="education">
    <ul class="space-y-3 text-[14.5px]">
      {
        profile.education.map((entry) => (
          <li>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] sm:items-baseline gap-x-6">
              <span>
                <strong class="font-semibold">{entry.school}</strong>
                <span class="text-[var(--color-ink-muted)] ml-2">{entry.degree}</span>
              </span>
              <time class="text-[13px] font-mono text-[var(--color-ink-subtle)] tabular-nums">
                {entry.period}
              </time>
            </div>
            {entry.activities && (
              <ul class="mt-1.5 space-y-1 pl-4 list-disc marker:text-[var(--color-ink-subtle)]">
                {entry.activities.map((activity) => (
                  <li class="text-[13px] text-[var(--color-ink-subtle)]">
                    {activity.text}
                    {activity.link && (
                      <>
                        {' · '}
                        <a
                          href={activity.link}
                          target="_blank"
                          rel="noopener"
                          class="text-[var(--color-ink-subtle)] hover:text-[var(--color-accent)] transition-colors"
                        >
                          {activity.linkLabel ?? '링크 ↗'}
                        </a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Certifications" id="certifications">
    <p class="text-[14.5px]">
      {
        profile.certifications.map((cert, i) => (
          <>
            {i > 0 && <span class="mx-3 text-[var(--color-ink-subtle)]">·</span>}
            <span class="font-medium">{cert.name}</span>
            <span class="text-[var(--color-ink-subtle)] font-mono ml-2">{cert.date}</span>
          </>
        ))
      }
    </p>
  </Section>

  <Section title="Awards" id="awards">
    <ul class="space-y-3 text-[14.5px]">
      {
        profile.awards.map((award) => (
          <li>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] sm:items-baseline gap-x-6">
              <span>
                <strong class="font-semibold">{award.name}</strong>
                <span class="text-[var(--color-ink-muted)] ml-2">{award.rank}</span>
              </span>
              <time class="text-[13px] font-mono text-[var(--color-ink-subtle)] tabular-nums">
                {award.date}
              </time>
            </div>
            <p class="text-[13px] text-[var(--color-ink-subtle)] mt-0.5">
              {award.description}
              {award.link && (
                <>
                  {' · '}
                  <a
                    href={award.link}
                    target="_blank"
                    rel="noopener"
                    class="text-[var(--color-ink-subtle)] hover:text-[var(--color-accent)] transition-colors"
                  >
                    GitHub ↗
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
