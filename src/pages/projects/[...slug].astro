---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const printName = `${profile.name}_${project.data.title}`;

// 이 프로젝트에 속한 트러블슈팅 사례 목록 (사이드바와 동일한 정렬 규칙).
const cases = (await getCollection('troubleshooting'))
  .filter((entry) => entry.id.split('/')[0] === project.id)
  .sort((a, b) => a.data.order - b.data.order);

// 이 프로젝트의 "AI 활용" 문서 (있는 프로젝트만 노출).
const aiUsage = (await getCollection('aiUsage')).find((entry) => entry.id === project.id);
---

<Base title={`${project.data.title} — 프로젝트`} description={project.data.summary} printName={printName}>
  <header class="mb-10">
    <p class="text-[13px] text-[var(--color-ink-subtle)] mb-2">
      {project.data.period}
    </p>
    <h1 class="text-[30px] md:text-[34px] font-bold leading-[1.25] tracking-tight mb-3">
      {project.data.title}
    </h1>
    <div class="flex gap-4 text-[14px]">
      {
        project.data.githubUrl && (
          <a
            href={project.data.githubUrl}
            target="_blank"
            rel="noreferrer"
            class="font-medium underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]"
          >
            {project.data.frontendGithubUrl ? 'GitHub (BE)' : 'GitHub'}
          </a>
        )
      }
      {
        project.data.frontendGithubUrl && (
          <a
            href={project.data.frontendGithubUrl}
            target="_blank"
            rel="noreferrer"
            class="font-medium underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]"
          >
            GitHub (FE)
          </a>
        )
      }
      {
        project.data.demoUrl && (
          <a
            href={project.data.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="font-medium underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]"
          >
            Demo
          </a>
        )
      }
    </div>
  </header>

  <p class="text-[15px] leading-[1.8] text-[var(--color-ink)] mb-10">
    {project.data.summary}
  </p>

  <nav aria-label="프로젝트 하위 문서">
    <ul class="doc-nav-list">
      <li>
        <a href={`/projects/${project.id}/overview/`} class="doc-nav-link">
          <span>서비스 개요</span>
          <span class="doc-nav-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      {
        cases.length > 0 && (
          <>
            <li class="doc-nav-divider" aria-hidden="true">
              문제 해결
            </li>
            {cases.map((entry) => {
              const caseId = entry.id.split('/')[1];
              return (
                <li>
                  <a
                    href={`/projects/${project.id}/troubleshooting/${caseId}/`}
                    class="doc-nav-link"
                  >
                    <span>{entry.data.title}</span>
                    <span class="doc-nav-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              );
            })}
          </>
        )
      }
      {
        aiUsage && (
          <>
            <li class="doc-nav-divider" aria-hidden="true">
              AI 활용
            </li>
            <li>
              <a href={`/projects/${project.id}/ai-usage/`} class="doc-nav-link">
                <span>{aiUsage.data.title}</span>
                <span class="doc-nav-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </>
        )
      }
    </ul>
  </nav>
</Base>

<style>
  .doc-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .doc-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-ink);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .doc-nav-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .doc-nav-arrow {
    color: var(--color-ink-subtle);
    transition: color 0.15s ease;
  }
  .doc-nav-link:hover .doc-nav-arrow {
    color: var(--color-accent);
  }
  .doc-nav-divider {
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-line);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
</style>
