---
interface Props {
  href: string;
  title: string;
  period: string;
  summary: string;
  techStack: string[];
}

const { href, title, period, summary, techStack } = Astro.props;
---

<a
  href={href}
  class="block rounded-lg border border-line p-4 transition-colors hover:border-accent hover:bg-accent-soft/40"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-medium text-ink">{title}</h3>
    <p class="text-xs text-ink-subtle">{period}</p>
  </div>
  <p class="mt-1.5 text-sm text-ink-muted">{summary}</p>
  {
    techStack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {techStack.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
    )
  }
</a>
