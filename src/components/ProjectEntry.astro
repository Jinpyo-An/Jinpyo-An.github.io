---
interface Props {
  title: string;
  role?: string;
  period?: string;
  summary?: string;
  techStack: string[];
  implementationHighlights?: string[];
  troubleshootingHighlights?: { title: string; href: string }[];
}
const {
  title,
  role,
  period,
  summary,
  techStack,
  implementationHighlights,
  troubleshootingHighlights,
} = Astro.props;

const summaryParagraphs = summary
  ? summary.split(/(?<=\.)\s+/).filter((p) => p.trim().length > 0)
  : [];
---

<article class="pb-7 print:pb-3 first:pt-0 last:pb-0">
  <header
    class="grid grid-cols-1 sm:grid-cols-[1fr_auto] sm:items-baseline gap-1 sm:gap-6 mb-3 print:mb-1.5"
  >
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
      <h3 class="text-[17px] font-semibold tracking-tight text-[var(--color-ink)]">
        {title}
      </h3>
      {role && <span class="text-[13px] text-[var(--color-ink-subtle)]">{role}</span>}
    </div>
    {
      period && (
        <time class="text-[13px] font-mono text-[var(--color-ink-subtle)] tabular-nums">
          {period}
        </time>
      )
    }
  </header>
  {
    summaryParagraphs.length > 0 && (
      <blockquote class="summary mb-4 print:mb-2 pl-4 border-l-[3px] border-[var(--color-accent)] text-[14.5px] leading-[1.7] print:leading-[1.45] text-[var(--color-ink-muted)] space-y-1.5 print:space-y-1">
        {summaryParagraphs.map((p) => <p>{p}</p>)}
      </blockquote>
    )
  }
  {
    techStack.length > 0 && (
      <p class="text-[13px] text-[var(--color-ink-subtle)] mb-2">{techStack.join(' · ')}</p>
    )
  }
  {
    implementationHighlights && implementationHighlights.length > 0 && (
      <div class="mb-2 print:mb-1">
        <p class="text-[12.5px] font-semibold text-[var(--color-ink-subtle)] mb-1">구현 내용</p>
        <ul class="space-y-1 print:space-y-0.5 pl-4 list-disc marker:text-[var(--color-ink-subtle)]">
          {implementationHighlights.map((item) => (
            <li class="text-[13px] text-[var(--color-ink)]">{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    troubleshootingHighlights && troubleshootingHighlights.length > 0 && (
      <div class="mb-3 print:mb-1.5">
        <p class="text-[12.5px] font-semibold text-[var(--color-ink-subtle)] mb-1">문제 해결</p>
        <ul class="space-y-1 print:space-y-0.5 pl-4 list-disc marker:text-[var(--color-ink-subtle)]">
          {troubleshootingHighlights.map((item) => (
            <li class="text-[13px] text-[var(--color-ink)]">
              {item.title}
              {' · '}
              <a
                href={item.href}
                class="text-[var(--color-ink-subtle)] hover:text-[var(--color-accent)] transition-colors"
              >
                문서 보기 ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .summary {
    border-left-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
</style>
