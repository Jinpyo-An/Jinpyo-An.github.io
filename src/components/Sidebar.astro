---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isProjects = pathname.startsWith('/projects');
const currentSlug = isProjects ? pathname.replace(/^\/projects\//, '').replace(/\/$/, '') : '';
---

<aside
  class="sidebar md:sticky md:top-0 md:h-screen md:overflow-hidden md:py-14 md:pl-8 md:pr-8 px-6 py-5 border-b md:border-b-0 md:border-r border-[var(--color-line)] flex md:flex-col md:gap-0 items-center md:items-stretch justify-between md:justify-start gap-4 bg-[var(--color-bg)] z-10"
>
  <a href="/" class="brand block">
    <h2 class="text-[22px] font-bold tracking-tight">{profile.name}</h2>
    <p class="text-[14.5px] font-mono text-[var(--color-ink-subtle)] mt-0.5 whitespace-nowrap">
      {profile.tagline}
    </p>
  </a>

  <nav class="hidden md:block mt-10 flex-1 min-h-0 overflow-y-auto">
    <ul class="space-y-0.5 text-[16px]">
      <li>
        <a href="/" class={`nav-link ${isHome ? 'is-active' : ''}`}>
          <span class="nav-marker" aria-hidden="true">›</span>
          <span>Resume</span>
        </a>
      </li>
      <li>
        <details open={isProjects} class="nav-tree">
          <summary
            id="projects-summary"
            class={`nav-link nav-summary ${isProjects ? 'is-active' : ''}`}
          >
            <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
            <span class="nav-summary-link">Projects</span>
          </summary>

          <ul class="nav-tree-list">
            {
              projects.map((project) => (
                <li>
                  <a
                    href={`/projects/${project.id}/`}
                    class={`nav-tree-item ${currentSlug === project.id ? 'is-active' : ''}`}
                  >
                    {project.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>

  <div class="md:mt-auto md:pt-8 flex items-center gap-2">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      title="테마 전환"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        class="hidden dark:block"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path></svg
      >
      <svg
        class="block dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
      >
    </button>
    <a
      href={profile.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      title="GitHub"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.58 0-.29-.01-1.04-.02-2.05-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 3-.4c1.02 0 2.05.13 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.85.12 3.15.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .33.22.7.83.58A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"
        ></path></svg
      >
    </a>
    <a
      href={`mailto:${profile.email}`}
      aria-label="이메일"
      title="이메일"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[#EA4335] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 24 18" fill="currentColor"
        ><path
          d="M24 .5v17c0 .276-.224.5-.5.5H20V7.225L12 12.5 4 7.225V18H.5a.5.5 0 0 1-.5-.5V.5C0 .107.37-.164.724.077L12 7.5 23.276.077C23.63-.164 24 .107 24 .5z"
        ></path></svg
      >
    </a>
    <button
      id="print-btn"
      type="button"
      aria-label="Print this page"
      title="이 페이지 인쇄"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><polyline points="6 9 6 2 18 2 18 9"></polyline><path
          d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
        ></path><rect x="6" y="14" width="12" height="8"></rect></svg
      >
    </button>

    <nav class="md:hidden flex gap-3 text-[13px]">
      <a href="/" class={isHome ? 'text-[var(--color-accent)]' : ''}>Resume</a>
      <a href="/#projects" class={isProjects ? 'text-[var(--color-accent)]' : ''}>Projects</a>
    </nav>
  </div>
</aside>

<script is:inline>
  (function () {
    var summary = document.getElementById('projects-summary');
    if (!summary) return;
    var details = summary.parentElement;
    summary.addEventListener('click', function () {
      if (details && !details.open) {
        window.location.href = '/#projects';
      }
    });
  })();
</script>

<style>
  .nav-link {
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: 6px 10px 6px 0;
    color: var(--color-ink-muted);
    transition: color 0.15s ease;
  }
  .nav-link .nav-marker {
    color: transparent;
    font-weight: 700;
    transform: translateY(-1px);
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover .nav-marker {
    color: var(--color-ink-subtle);
  }
  .nav-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }
  .nav-link.is-active .nav-marker {
    color: var(--color-accent);
  }

  .nav-link .nav-marker-toggle {
    color: var(--color-ink-subtle);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .nav-tree[open] > .nav-summary .nav-marker-toggle {
    transform: translateY(-1px) rotate(90deg);
  }

  .nav-tree {
    margin: 0;
  }
  .nav-summary {
    cursor: pointer;
    list-style: none;
  }
  .nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-summary-link {
    color: inherit;
  }
  .nav-summary-link:hover {
    color: inherit;
  }

  .nav-tree-list {
    margin-top: 4px;
    padding-left: 14px;
    border-left: 1px solid var(--color-line);
    margin-left: 5px;
  }
  .nav-tree-list > li + li {
    margin-top: 4px;
  }

  .nav-tree-item {
    display: block;
    padding: 4px 8px 4px 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink-subtle);
    transition: color 0.15s ease;
    border-left: 2px solid transparent;
    padding-left: 8px;
    margin-left: -8px;
  }
  .nav-tree-item:hover {
    color: var(--color-ink-muted);
  }
  .nav-tree-item.is-active {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
  }
</style>
