---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname;
---

<aside
  class="no-print border-b border-line bg-surface px-4 py-4 lg:fixed lg:inset-y-0 lg:left-0 lg:w-64 lg:overflow-y-auto lg:border-b-0 lg:border-r lg:px-6 lg:py-8"
>
  <div class="flex items-center justify-between gap-3 lg:flex-col lg:items-start lg:gap-6">
    <a href="/" class="min-w-0">
      <p class="truncate font-semibold text-ink">{profile.name}</p>
      <p class="truncate text-xs text-ink-subtle">{profile.tagline}</p>
    </a>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="다크모드 전환"
        class="rounded-md border border-line p-2 text-ink-muted transition-colors hover:text-accent"
      >
        <svg data-icon="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg data-icon="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-4 w-4">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button
        id="print-button"
        type="button"
        aria-label="인쇄 / PDF로 저장"
        class="rounded-md border border-line p-2 text-ink-muted transition-colors hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
      </button>
    </div>
  </div>

  <nav class="mt-6 hidden text-sm lg:block">
    <a
      href="/"
      class:list={[
        'block rounded-md px-2 py-1.5 transition-colors',
        currentPath === '/' ? 'bg-accent-soft text-accent font-medium' : 'text-ink-muted hover:text-accent',
      ]}
    >
      Resume
    </a>

    <p class="mt-4 px-2 text-xs font-semibold uppercase tracking-wide text-ink-subtle">Projects</p>
    <ul class="mt-1">
      {
        projects.map((project) => {
          const href = `/projects/${project.id}/`;
          const active = currentPath === href;
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'block truncate rounded-md px-2 py-1.5 transition-colors',
                  active ? 'bg-accent-soft text-accent font-medium' : 'text-ink-muted hover:text-accent',
                ]}
              >
                {project.data.title}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-6 flex gap-3 border-t border-line px-2 pt-4 text-ink-subtle">
      <a href={profile.githubUrl} target="_blank" rel="noreferrer" class="hover:text-accent" aria-label="GitHub">
        GitHub
      </a>
      <a href={`mailto:${profile.email}`} class="hover:text-accent" aria-label="이메일">
        Email
      </a>
    </div>
  </nav>
</aside>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const sunIcon = toggle?.querySelector('[data-icon="sun"]');
  const moonIcon = toggle?.querySelector('[data-icon="moon"]');

  function syncIcon() {
    const isDark = root.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', isDark);
    moonIcon?.classList.toggle('hidden', !isDark);
  }

  syncIcon();

  toggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncIcon();
  });

  document.getElementById('print-button')?.addEventListener('click', () => window.print());
</script>
