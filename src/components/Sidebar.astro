---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const troubleshootingEntries = (await getCollection('troubleshooting')).sort(
  (a, b) => a.data.order - b.data.order,
);
const aiUsageEntries = await getCollection('aiUsage');

// 프로젝트별로 목차("서비스 개요" 링크 + 트러블슈팅 사례 목록 + AI 활용 문서)를 구성한다.
const projectNavs = projects.map((project) => {
  const cases = troubleshootingEntries.filter((entry) => entry.id.split('/')[0] === project.id);
  const aiUsage = aiUsageEntries.find((entry) => entry.id === project.id);
  return { project, cases, aiUsage };
});

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isProjects = pathname.startsWith('/projects');
const currentProjectId = pathname.match(/^\/projects\/([^/]+)\/?/)?.[1] ?? '';
const isOverviewPage = /^\/projects\/[^/]+\/overview\/?$/.test(pathname);
const currentCaseId = pathname.match(/^\/projects\/[^/]+\/troubleshooting\/([^/]+)\/?/)?.[1] ?? '';
const isAiUsagePage = /^\/projects\/[^/]+\/ai-usage\/?$/.test(pathname);
---

<aside
  class="sidebar md:sticky md:top-0 md:h-screen md:overflow-hidden md:py-14 md:pl-8 md:pr-8 px-6 py-5 border-b md:border-b-0 md:border-r border-[var(--color-line)] flex md:flex-col md:gap-0 items-center md:items-stretch justify-between md:justify-start gap-4 bg-[var(--color-bg)] z-10"
>
  <a href="/" class="brand block">
    <h2 class="text-[22px] font-bold tracking-tight">{profile.name}</h2>
    <p class="text-[14.5px] font-mono text-[var(--color-ink-subtle)] mt-0.5 whitespace-nowrap">
      {profile.tagline}
    </p>
  </a>

  <nav class="hidden md:block mt-10 flex-1 min-h-0 overflow-y-auto" data-is-home={isHome ? 'true' : 'false'}>
    <ul class="space-y-0.5 text-[16px]">
      <li>
        <a href="/" class={`nav-link ${isHome ? 'is-active' : ''}`}>
          <span class="nav-marker" aria-hidden="true">›</span>
          <span>Resume</span>
        </a>
      </li>
      <li>
        <details open={isProjects} class="nav-tree" data-nav-key="portfolio">
          <summary class={`nav-link nav-summary ${isProjects ? 'is-active' : ''}`} data-nav-href="/projects/">
            <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
            <span class="nav-summary-link">Portfolio</span>
          </summary>

          <ul class="nav-tree-list">
            {
              projectNavs.map(({ project, cases, aiUsage }) => {
                const isCurrentProject = currentProjectId === project.id;
                return (
                  <li>
                    <details
                      class="nav-tree"
                      data-nav-key={`project:${project.id}`}
                      open={isCurrentProject}
                    >
                      <summary
                        class={`nav-link nav-summary text-[13px] ${isCurrentProject ? 'is-active' : ''}`}
                        data-nav-href={`/projects/${project.id}/`}
                      >
                        <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
                        <span class="nav-summary-link">{project.data.title}</span>
                      </summary>

                      <ul class="nav-tree-list">
                        <li>
                          <a
                            href={`/projects/${project.id}/overview/`}
                            class={`nav-tree-item ${isCurrentProject && isOverviewPage ? 'is-active' : ''}`}
                          >
                            서비스 개요
                          </a>
                        </li>
                        {cases.length > 0 && (
                          <>
                            <li class="nav-tree-divider" aria-hidden="true">
                              문제 해결
                            </li>
                            {cases.map((entry) => {
                              const caseId = entry.id.split('/')[1];
                              return (
                                <li>
                                  <a
                                    href={`/projects/${project.id}/troubleshooting/${caseId}/`}
                                    class={`nav-tree-item ${
                                      isCurrentProject && currentCaseId === caseId ? 'is-active' : ''
                                    }`}
                                  >
                                    {entry.data.title}
                                  </a>
                                </li>
                              );
                            })}
                          </>
                        )}
                        {aiUsage && (
                          <>
                            <li class="nav-tree-divider" aria-hidden="true"></li>
                            <li>
                              <a
                                href={`/projects/${project.id}/ai-usage/`}
                                class={`nav-tree-item ${isCurrentProject && isAiUsagePage ? 'is-active' : ''}`}
                              >
                                {aiUsage.data.title}
                              </a>
                            </li>
                          </>
                        )}
                      </ul>
                    </details>
                  </li>
                );
              })
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>

  <div class="md:mt-auto md:pt-8 flex items-center gap-2">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      title="테마 전환"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        class="hidden dark:block"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path></svg
      >
      <svg
        class="block dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
      >
    </button>
    <button
      id="print-btn"
      type="button"
      aria-label="Print this page"
      title="이 페이지 인쇄"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><polyline points="6 9 6 2 18 2 18 9"></polyline><path
          d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
        ></path><rect x="6" y="14" width="12" height="8"></rect></svg
      >
    </button>

    <nav class="md:hidden flex gap-3 text-[13px]">
      <a href="/" class={isHome ? 'text-[var(--color-accent)]' : ''}>Resume</a>
      <a href="/projects/" class={isProjects ? 'text-[var(--color-accent)]' : ''}>Portfolio</a>
    </nav>
  </div>
</aside>

<script is:inline>
  (function () {
    var STORAGE_PREFIX = 'sidebar-open:';
    var CARRY_KEY = 'sidebar-carry-open';
    var navEl = document.querySelector('nav[data-is-home]');
    var isHome = !!navEl && navEl.dataset.isHome === 'true';
    // 프로젝트 목록 허브(/projects/) 페이지인지 여부. 이 페이지에서는 어떤
    // 프로젝트도 "현재 보고 있는" 상태가 아니므로 서버가 프로젝트별 details를
    // 전부 접힌 채로 내려준다.
    var isProjectsHub = /^\/projects\/?$/.test(window.location.pathname);
    // 지금 보고 있는 프로젝트의 id(프로젝트 상세/트러블슈팅/AI 활용 페이지에서만 값이 있음).
    var currentProjectId = window.location.pathname.match(/^\/projects\/([^/]+)\/?/)?.[1] ?? '';

    var detailsList = Array.prototype.slice.call(document.querySelectorAll('details[data-nav-key]'));

    // 방금 떠난 페이지에서 실제로 펼쳐져 있던 details의 스냅샷(있다면 한 번만 사용).
    // localStorage의 "예전에 방문했을 때 남은" 상태와는 별개로, "이동하기 바로
    // 전 화면에 보이던 상태"만 딱 한 번 다음 페이지로 이어주기 위한 용도다 —
    // 사용자가 방금 화살표로 다른 프로젝트를 펼쳐두고 다른 항목을 클릭해 이동한
    // 경우, 그 프로젝트가 이동 후에도 열린 채 유지되게 한다. sessionStorage를
    // 쓰므로 오래된 방문 기록(다른 세션)까지 되살리지는 않는다.
    var carryOpen = null;
    if (!isHome) {
      try {
        var raw = sessionStorage.getItem(CARRY_KEY);
        if (raw) carryOpen = JSON.parse(raw);
        sessionStorage.removeItem(CARRY_KEY);
      } catch (_) {}
    }

    // 트리 펼침/접힘 상태를 localStorage에 저장해서 새로고침 후에도 유지한다.
    // 저장된 값이 없으면(첫 방문) 서버에서 계산한 기본 상태(현재 보고 있는
    // 프로젝트만 펼침)를 그대로 둔다.
    // 단, 홈 화면에서는 이 복원을 건너뛴다 — 프로젝트 페이지를 보다가 홈으로
    // 돌아왔을 때 예전에 펼쳐뒀던 상태가 되살아나 트리가 펼쳐진 채로 보이는
    // 것을 막고, 서버 기본값(전부 접힘)을 그대로 유지하기 위해서다.
    // 프로젝트 목록 허브 페이지에서도 마찬가지 이유로 "portfolio" 자신을 뺀
    // 나머지(프로젝트별 details)는 복원을 건너뛴다 — 그렇지 않으면 예전에 봤던
    // 프로젝트 상세 페이지의 펼침 상태가 되살아나 Portfolio를 눌렀을 때 모든
    // 프로젝트 토글이 함께 펼쳐지는 문제가 생긴다.
    // 마찬가지로 어떤 프로젝트 상세를 보고 있을 때, "다른" 프로젝트의
    // project:* 키도 복원을 건너뛴다 — 안 그러면 예전에 그 다른 프로젝트를
    // 봤을 때 저장된 펼침 상태가 되살아나, 지금 보는 프로젝트를 열었는데 다른
    // 프로젝트 토글까지 함께 펼쳐지는 문제가 생긴다. 다만 carryOpen 스냅샷에
    // 해당 키가 있으면(직전 화면에서 실제로 펼쳐뒀던 것이면) 그 값을 최우선으로
    // 따른다.
    detailsList.forEach(function (details) {
      var navKey = details.dataset.navKey;
      var key = STORAGE_PREFIX + navKey;

      if (carryOpen && Object.prototype.hasOwnProperty.call(carryOpen, navKey)) {
        details.open = !!carryOpen[navKey];
      } else {
        var isOtherProjectKey =
          navKey.indexOf('project:') === 0 && navKey !== 'project:' + currentProjectId;
        var skipRestore = isHome || (isProjectsHub && navKey !== 'portfolio') || isOtherProjectKey;
        if (!skipRestore) {
          var stored = null;
          try {
            stored = localStorage.getItem(key);
          } catch (_) {}
          if (stored !== null) {
            details.open = stored === '1';
          }
        }
      }

      details.addEventListener('toggle', function () {
        try {
          localStorage.setItem(key, details.open ? '1' : '0');
        } catch (_) {}
      });
    });

    // 페이지를 떠나기 직전, 지금 화면에 실제로 펼쳐져 있는 details 상태를
    // sessionStorage에 스냅샷으로 남겨서 다음 페이지가 한 번만 이어받게 한다.
    window.addEventListener('pagehide', function () {
      try {
        var snapshot = {};
        detailsList.forEach(function (d) {
          snapshot[d.dataset.navKey] = d.open;
        });
        sessionStorage.setItem(CARRY_KEY, JSON.stringify(snapshot));
      } catch (_) {}
    });

    // summary(제목)를 클릭했을 때의 규칙은 Portfolio와 개별 프로젝트 항목이 동일하다.
    // 이미 펼쳐진 상태에서 제목을 클릭하면: 이동 대상이 "지금 보고 있는 페이지
    // 자기 자신"이면 접기만 하고(화살표와 동일하게 동작), 그게 아니라 실제로
    // 다른 문서로 가야 하는 경우(예: 프로젝트 상세를 보다가 Portfolio를 클릭해
    // 전체 목록으로 돌아가는 경우)에는 그대로 이동한다. 닫힌 상태라면 펼치면서
    // 함께 이동한다.
    // (과거에는 Portfolio만 화살표가 없어 제목 클릭이 접기/펼치기를 겸했는데, 그
    // 결과 이미 펼쳐진 Portfolio를 클릭하면 접기만 하고 #projects로 이동하지 않는
    // 버그가 있었다. 지금은 "자기 자신 페이지일 때만 접기"로 조건을 좁혀서, 실제로
    // 이동해야 하는 클릭은 항상 이동을 보장하면서도 같은 페이지를 가리키는 클릭은
    // 접기로 처리한다.)
    //
    // "펼치는 클릭"의 이동 대상이 실제로 다른 문서로 가는 경우(다른 URL, 혹은
    // 현재 페이지와 같은 URL이라도 전체 새로고침이 일어나는 경우)에는 네이티브
    // 토글의 'toggle' 이벤트(비동기)가 발생할 시간도 없이 문서가 언로드되어,
    // localStorage에 펼침 상태가 기록되지 못한 채 새로고침된다. 그러면 새로고침된
    // 페이지에서 이전에 저장된 "닫힘" 값을 그대로 읽어와 다시 접힌 채로 렌더링되는
    // 문제가 생긴다. 그래서 details.open과 localStorage를 클릭 시점에 직접
    // 동기적으로 기록해준다.
    function withTrailingSlash(path) {
      return path.charAt(path.length - 1) === '/' ? path : path + '/';
    }

    document.querySelectorAll('summary[data-nav-href]').forEach(function (summary) {
      var details = summary.parentElement;
      var toggle = summary.querySelector('.nav-marker-toggle');

      if (toggle) {
        toggle.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          if (details) details.open = !details.open;
        });
      }

      summary.addEventListener('click', function (event) {
        var isSelfPage =
          withTrailingSlash(window.location.pathname) === withTrailingSlash(summary.dataset.navHref);
        if (details && details.open) {
          if (isSelfPage) {
            // 지금 보고 있는 페이지 자신을 가리키는 상태로 펼쳐져 있으면, 이동
            // 대신 화살표와 동일하게 접기만 한다.
            event.preventDefault();
            details.open = false;
            return;
          }
          // 다른 문서로 이동해야 하는 클릭은 접지 않고 항상 이동한다(네이티브
          // 토글로 인한 접힘은 막는다).
          event.preventDefault();
          window.location.href = summary.dataset.navHref;
          return;
        }
        // 접힌 상태를 펼치는 클릭 → 펼침과 함께 이동한다.
        if (details) {
          event.preventDefault();
          details.open = true;
          try {
            localStorage.setItem(STORAGE_PREFIX + details.dataset.navKey, '1');
          } catch (_) {}
        }
        window.location.href = summary.dataset.navHref;
      });
    });
  })();
</script>

<style>
  .nav-link {
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: 6px 10px 6px 0;
    color: var(--color-ink-muted);
    transition: color 0.15s ease;
  }
  .nav-link .nav-marker {
    color: transparent;
    font-weight: 700;
    transform: translateY(-1px);
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-link .nav-marker-toggle {
    color: var(--color-ink-subtle);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .nav-tree[open] > .nav-summary .nav-marker-toggle {
    transform: translateY(-1px) rotate(90deg);
  }

  .nav-tree {
    margin: 0;
  }
  .nav-summary {
    cursor: pointer;
    list-style: none;
  }
  .nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-summary-link {
    color: inherit;
  }
  .nav-summary-link:hover {
    color: inherit;
  }

  .nav-tree-list {
    margin-top: 4px;
    padding-left: 14px;
    border-left: 1px solid var(--color-line);
    margin-left: 5px;
  }
  .nav-tree-list > li + li {
    margin-top: 4px;
  }

  .nav-tree-item {
    display: block;
    padding: 4px 8px 4px 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink-subtle);
    transition: color 0.15s ease;
    border-left: 2px solid transparent;
    padding-left: 8px;
    margin-left: -8px;
  }
  .nav-tree-item:hover {
    color: var(--color-ink-muted);
  }
  .nav-tree-item.is-active {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
  }

  .nav-tree-divider {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--color-line);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
</style>
