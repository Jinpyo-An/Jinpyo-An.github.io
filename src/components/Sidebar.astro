---
import { getCollection, render } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const troubleshootingEntries = (await getCollection('troubleshooting')).sort(
  (a, b) => a.data.order - b.data.order,
);

// 프로젝트별로 목차(서비스 설명/서비스 구조 앵커 + 트러블슈팅 사례 목록)를 구성한다.
// 앵커 id는 본문 ## 헤딩에서 Astro가 자동 생성한 슬러그를 그대로 사용한다.
const projectNavs = await Promise.all(
  projects.map(async (project) => {
    const { headings } = await render(project);
    const [service, structure] = headings.filter((heading) => heading.depth === 2);
    const cases = troubleshootingEntries.filter((entry) => entry.id.split('/')[0] === project.id);
    return { project, service, structure, cases };
  }),
);

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isProjects = pathname.startsWith('/projects');
const currentProjectId = pathname.match(/^\/projects\/([^/]+)\/?/)?.[1] ?? '';
const currentCaseId = pathname.match(/^\/projects\/[^/]+\/troubleshooting\/([^/]+)\/?/)?.[1] ?? '';
---

<aside
  class="sidebar md:sticky md:top-0 md:h-screen md:overflow-hidden md:py-14 md:pl-8 md:pr-8 px-6 py-5 border-b md:border-b-0 md:border-r border-[var(--color-line)] flex md:flex-col md:gap-0 items-center md:items-stretch justify-between md:justify-start gap-4 bg-[var(--color-bg)] z-10"
>
  <a href="/" class="brand block">
    <h2 class="text-[22px] font-bold tracking-tight">{profile.name}</h2>
    <p class="text-[14.5px] font-mono text-[var(--color-ink-subtle)] mt-0.5 whitespace-nowrap">
      {profile.tagline}
    </p>
  </a>

  <nav class="hidden md:block mt-10 flex-1 min-h-0 overflow-y-auto">
    <ul class="space-y-0.5 text-[16px]">
      <li>
        <a href="/" class={`nav-link ${isHome ? 'is-active' : ''}`}>
          <span class="nav-marker" aria-hidden="true">›</span>
          <span>Resume</span>
        </a>
      </li>
      <li>
        <details open={isProjects} class="nav-tree" data-nav-key="portfolio">
          <summary class={`nav-link nav-summary ${isProjects ? 'is-active' : ''}`} data-nav-href="/#projects">
            <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
            <span class="nav-summary-link">Portfolio</span>
          </summary>

          <ul class="nav-tree-list">
            {
              projectNavs.map(({ project, service, structure, cases }) => {
                const isCurrentProject = currentProjectId === project.id;
                return (
                  <li>
                    <details
                      class="nav-tree"
                      data-nav-key={`project:${project.id}`}
                      open={isCurrentProject}
                    >
                      <summary
                        class={`nav-link nav-summary text-[13px] ${isCurrentProject ? 'is-active' : ''}`}
                        data-nav-href={`/projects/${project.id}/`}
                      >
                        <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
                        <span class="nav-summary-link">{project.data.title}</span>
                      </summary>

                      <ul class="nav-tree-list">
                        {service && (
                          <li>
                            <a href={`/projects/${project.id}/#${service.slug}`} class="nav-tree-item">
                              {service.text}
                            </a>
                          </li>
                        )}
                        {structure && (
                          <li>
                            <a href={`/projects/${project.id}/#${structure.slug}`} class="nav-tree-item">
                              {structure.text}
                            </a>
                          </li>
                        )}
                        {cases.length > 0 && (
                          <>
                            <li class="nav-tree-divider" aria-hidden="true">
                              문제 해결
                            </li>
                            {cases.map((entry) => {
                              const caseId = entry.id.split('/')[1];
                              return (
                                <li>
                                  <a
                                    href={`/projects/${project.id}/troubleshooting/${caseId}/`}
                                    class={`nav-tree-item ${
                                      isCurrentProject && currentCaseId === caseId ? 'is-active' : ''
                                    }`}
                                  >
                                    {entry.data.title}
                                  </a>
                                </li>
                              );
                            })}
                          </>
                        )}
                      </ul>
                    </details>
                  </li>
                );
              })
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>

  <div class="md:mt-auto md:pt-8 flex items-center gap-2">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      title="테마 전환"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        class="hidden dark:block"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path></svg
      >
      <svg
        class="block dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
      >
    </button>
    <button
      id="print-btn"
      type="button"
      aria-label="Print this page"
      title="이 페이지 인쇄"
      class="icon-btn inline-flex items-center justify-center w-8 h-8 rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><polyline points="6 9 6 2 18 2 18 9"></polyline><path
          d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
        ></path><rect x="6" y="14" width="12" height="8"></rect></svg
      >
    </button>

    <nav class="md:hidden flex gap-3 text-[13px]">
      <a href="/" class={isHome ? 'text-[var(--color-accent)]' : ''}>Resume</a>
      <a href="/#projects" class={isProjects ? 'text-[var(--color-accent)]' : ''}>Portfolio</a>
    </nav>
  </div>
</aside>

<script is:inline>
  (function () {
    var STORAGE_PREFIX = 'sidebar-open:';

    // 트리 펼침/접힘 상태를 localStorage에 저장해서 새로고침 후에도 유지한다.
    // 저장된 값이 없으면(첫 방문) 서버에서 계산한 기본 상태(현재 보고 있는
    // 프로젝트만 펼침)를 그대로 둔다.
    document.querySelectorAll('details[data-nav-key]').forEach(function (details) {
      var key = STORAGE_PREFIX + details.dataset.navKey;
      var stored = null;
      try {
        stored = localStorage.getItem(key);
      } catch (_) {}
      if (stored !== null) {
        details.open = stored === '1';
      }
      details.addEventListener('toggle', function () {
        try {
          localStorage.setItem(key, details.open ? '1' : '0');
        } catch (_) {}
      });
    });

    // summary(제목)를 클릭하면 펼침/접힘 상태와 무관하게 항상 해당 링크로 이동한다.
    // Portfolio(최상위 트리)는 같은 페이지 내 앵커로 이동하므로 텍스트를 클릭해도
    // 네이티브 펼침/접힘이 함께 일어나도 안전하다. 반면 개별 프로젝트 항목은 현재
    // 보고 있는 프로젝트 자신을 클릭하면 같은 페이지가 새로고침되는데, 이때 네이티브
    // 토글까지 겹치면 "닫힘" 상태가 localStorage에 저장된 직후 새로고침되어 현재
    // 프로젝트인데도 사이드바가 접힌 채로 뜨는 문제가 생긴다. 그래서 개별 프로젝트는
    // 화살표(nav-marker-toggle)를 클릭했을 때만 펼침/접힘이 동작하도록 분리한다.
    document.querySelectorAll('summary[data-nav-href]').forEach(function (summary) {
      var details = summary.parentElement;
      var isPortfolio = details && details.dataset.navKey === 'portfolio';
      var toggle = summary.querySelector('.nav-marker-toggle');

      if (toggle && !isPortfolio) {
        toggle.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          if (details) details.open = !details.open;
        });
      }

      summary.addEventListener('click', function (event) {
        if (!isPortfolio) {
          event.preventDefault();
        }
        window.location.href = summary.dataset.navHref;
      });
    });
  })();
</script>

<style>
  .nav-link {
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: 6px 10px 6px 0;
    color: var(--color-ink-muted);
    transition: color 0.15s ease;
  }
  .nav-link .nav-marker {
    color: transparent;
    font-weight: 700;
    transform: translateY(-1px);
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover .nav-marker {
    color: var(--color-ink-subtle);
  }
  .nav-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-link .nav-marker-toggle {
    color: var(--color-ink-subtle);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .nav-tree[open] > .nav-summary .nav-marker-toggle {
    transform: translateY(-1px) rotate(90deg);
  }

  .nav-tree {
    margin: 0;
  }
  .nav-summary {
    cursor: pointer;
    list-style: none;
  }
  .nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-summary-link {
    color: inherit;
  }
  .nav-summary-link:hover {
    color: inherit;
  }

  .nav-tree-list {
    margin-top: 4px;
    padding-left: 14px;
    border-left: 1px solid var(--color-line);
    margin-left: 5px;
  }
  .nav-tree-list > li + li {
    margin-top: 4px;
  }

  .nav-tree-item {
    display: block;
    padding: 4px 8px 4px 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink-subtle);
    transition: color 0.15s ease;
    border-left: 2px solid transparent;
    padding-left: 8px;
    margin-left: -8px;
  }
  .nav-tree-item:hover {
    color: var(--color-ink-muted);
  }
  .nav-tree-item.is-active {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
  }

  .nav-tree-divider {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--color-line);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
</style>
